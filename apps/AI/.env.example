# Must match apps/Backend INTERNAL_API_KEY — validates X-INTERNAL-API-KEY from the Node gateway
INTERNAL_API_KEY=change-me-internal-ai-key-shared-with-fastapi

# Comma-separated hostnames for TrustedHostMiddleware (default in code includes localhost)
# AI_ALLOWED_HOSTS=127.0.0.1,localhost

# Same DB as Backend if AI reads/writes shared tables
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

GROQ_API_KEY=

# Playwright PDF (report): avoid timeouts when fonts.googleapis.com is slow
# PDF_PLAYWRIGHT_TIMEOUT_MS=120000
