{
  "info": {
    "name": "Heart Disease Prediction - Unified API (Simple)",
    "_postman_id": "hd-prediction-api-2026-simple",
    "description": "Frontend-ready minimal collection.\n\nFlow:\n1) Auth -> Register (any user)\n2) Auth -> Login (any user) (saves token + clears labtest_id)\n3) Lab Tests -> Upload CSV (current user) (saves labtest_id)\n4) Lab Tests -> Get My Status (me)\n5) AI & ML -> Start Prediction (uses labtest_id)\n\nRules:\n- If Get My Status says hasLabTests=false => show Labs page\n- If prediction decision=low => show only decision + probability\n- If prediction decision=high => show hospitals + SHAP + report\n\nBase URLs:\n- Backend: http://localhost:5000\n- AI: http://127.0.0.1:8000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000", "type": "string" },
    { "key": "ai_url", "value": "http://127.0.0.1:8000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "labtest_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (any user)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"national_id\": \"\",\n  \"username\": \"\",\n  \"email\": \"\",\n  \"password\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login (any user)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (pm.response.code === 200 && json.token) {",
                  "  pm.environment.set('token', json.token);",
                  "  pm.environment.set('national_id', json.data.national_id);",
                  "  pm.environment.set('labtest_id', '');",
                  "}",
                  "console.log('Login response:', json);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"\",\n  \"password\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "Lab Tests",
      "item": [
        {
          "name": "Upload CSV (current user)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (pm.response.code === 201 && json.created && json.created.id) {",
                  "  pm.environment.set('labtest_id', json.created.id);",
                  "  console.log('✅ labtest_id saved:', json.created.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": [] }]
            },
            "url": { "raw": "{{base_url}}/api/labtests/upload-csv", "host": ["{{base_url}}"], "path": ["api", "labtests", "upload-csv"] }
          }
        },
        {
          "name": "Get My Status (me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/labtests/me/status", "host": ["{{base_url}}"], "path": ["api", "labtests", "me", "status"] }
          }
        }
      ]
    },
    {
      "name": "Labs (read-only)",
      "item": [
        {
          "name": "Get All Labs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/labs?page=1&limit=50",
              "host": ["{{base_url}}"],
              "path": ["api", "labs"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "50" }
              ]
            }
          }
        },
        {
          "name": "Get Lab by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/labs/{{lab_id}}", "host": ["{{base_url}}"], "path": ["api", "labs", "{{lab_id}}"] }
          }
        }
      ]
    },
    {
      "name": "Hospitals (read-only)",
      "item": [
        {
          "name": "Get All Hospitals",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/hospitals?page=1&limit=50",
              "host": ["{{base_url}}"],
              "path": ["api", "hospitals"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "50" }
              ]
            }
          }
        },
        {
          "name": "Get Hospitals by Area",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/hospitals/area/{{area}}", "host": ["{{base_url}}"], "path": ["api", "hospitals", "area", "{{area}}"] }
          }
        }
      ]
    },
    {
      "name": "AI & ML",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const labtestId = pm.environment.get('labtest_id');",
              "const nationalId = pm.environment.get('national_id');",
              "pm.variables.set('target_id', labtestId ? labtestId : nationalId);"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Start Prediction (uses labtest_id)",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{ai_url}}/predict/{{target_id}}", "host": ["{{ai_url}}"], "path": ["predict", "{{target_id}}"] }
          }
        },
        {
          "name": "Get SHAP Explanation (high risk only)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{ai_url}}/shap/{{target_id}}", "host": ["{{ai_url}}"], "path": ["shap", "{{target_id}}"] }
          }
        },
        {
          "name": "Get PDF Medical Report (high risk only)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{ai_url}}/predict/{{target_id}}/report", "host": ["{{ai_url}}"], "path": ["predict", "{{target_id}}", "report"] }
          }
        }
      ]
    }
  ]
}

